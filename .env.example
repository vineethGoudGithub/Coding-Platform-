# ==============================================================================
# Database Configuration (MySQL / Aiven Cloud)
# ==============================================================================
# For Aiven MySQL:
# DB_URL=jdbc:mysql://<aiven-host>:<aiven-port>/<database-name>?sslMode=REQUIRED
# For Local MySQL:
DB_URL=jdbc:mysql://localhost:3306/JavaResults?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=root

# ==============================================================================
# JWT Authentication Security (HS256 minimum 256-bit secret)
# ==============================================================================
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ==============================================================================
# Code Execution Engine (Judge0)
# ==============================================================================
# Public CE Endpoint: https://ce.judge0.com or RapidAPI Judge0 endpoint
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# ==============================================================================
# Default Admin Seed Account (Only created on first startup if not exists)
# ==============================================================================
